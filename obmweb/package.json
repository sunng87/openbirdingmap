{
	"name": "obmweb",
	"scripts": {
		"ancient": "clojure -Sdeps '{:deps {com.github.liquidz/antq {:mvn/version \"RELEASE\"}}}' -m antq.core",
		"copy:maplibre": "mkdir -p resources/public/js/vendor && cp node_modules/maplibre-gl/dist/maplibre-gl.mjs node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl.css resources/public/js/vendor/",
		"watch": "npm run copy:maplibre && npx shadow-cljs watch app",
		"release": "npm run copy:maplibre && npx shadow-cljs release app",
		"build-report": "npx shadow-cljs run shadow.cljs.build-report app target/build-report.html"
	},
	"dependencies": {
		"@blueprintjs/core": "^6.20.0",
		"@blueprintjs/select": "^6.3.6",
		"chart.js": "4.5.1",
		"highlight.js": "11.12.0",
		"maplibre-gl": "6.10.0",
		"react": "19.3.0",
		"react-chartjs-2": "^5.3.1",
		"react-dom": "19.3.0",
		"react-map-gl": "^8.1.3"
	},
	"overrides": {
		"change-case": "5.0.2"
	},
	"devDependencies": {
		"shadow-cljs": "3.5.3"
	}
}
