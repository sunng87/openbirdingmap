{:ebird-api-key "KEY"
 ;; xeno-canto API v3 key, required for the Sounds section (register at
 ;; https://xeno-canto.org/explore/api). Sounds are disabled when unset.
 :xeno-canto-api-key "KEY"
 ;; optional, path to the stickers/ subdirectory of a huashu-bird-sticker
 ;; clone (https://github.com/alchaincyf/huashu-bird-sticker); enables
 ;; /api/stickers/... images on species pages. Can also be set with the
 ;; OBM_STICKER_DIR env var. Disabled when unset.
 :obm.sticker.dir "/path/to/huashu-bird-sticker/stickers"
 :http-port 8080}
